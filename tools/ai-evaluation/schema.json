{
  "$defs": {
    "Customer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "phone": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Phone"
        },
        "township": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Township"
        },
        "address": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Address"
        }
      },
      "required": [
        "name",
        "phone",
        "township",
        "address"
      ],
      "title": "Customer",
      "type": "object"
    },
    "Draft": {
      "additionalProperties": false,
      "properties": {
        "customer": {
          "$ref": "#/$defs/Customer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "maxItems": 20,
          "title": "Items",
          "type": "array"
        },
        "delivery_fee": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delivery Fee"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        }
      },
      "required": [
        "customer",
        "items",
        "delivery_fee",
        "note"
      ],
      "title": "Draft",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "quote": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "field",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "product_name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product Name"
        },
        "qty": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qty"
        },
        "unit_price": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Price"
        }
      },
      "required": [
        "product_name",
        "qty",
        "unit_price"
      ],
      "title": "Item",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "draft": {
      "$ref": "#/$defs/Draft"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 70,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "draft",
    "evidence"
  ],
  "title": "Extraction",
  "type": "object"
}
